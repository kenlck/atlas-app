{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.ts",
    "eslint.config.js",
    "prettier.config.js"
  ],
  "exclude": ["node_modules", "dist", ".output"]
}
